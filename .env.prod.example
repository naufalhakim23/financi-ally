# cp .env.prod.example .env.prod && edit. See docs/deploy.md.

# Bare hostname. Its DNS A record must resolve here before first boot.
SITE_ADDRESS=financially.example.com

POSTGRES_DB=financially
POSTGRES_USER=financially
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32. Rotating it signs every session out.
JWT_SECRET=

# Flip true, register, flip back.
REGISTRATION_OPEN=false

BASE_CURRENCY_DEFAULT=IDR
RECURRING_TZ=Asia/Jakarta

# Production refuses to boot with neither a key nor MAIL_MOCK=true.
RESEND_API_KEY=
MAIL_FROM=Financi-Ally <onboarding@resend.dev>
MAIL_MOCK=false

# Leave both empty to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Copy to .env. All are optional, with defaults that hit the local docker-compose Postgres.
SERVER_PORT=8080
ENVIRONMENT=development

# Matches docker/compose.yml (financially:financially@localhost:5433/financially).
DATABASE_URL=postgres://financially:financially@localhost:5433/financially?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE=5m
DB_CONN_MAX_LIFE=1h

# --- Auth (M1) ---
# CHANGE THIS. Production refuses to boot with the default value.
JWT_SECRET=change-this-jwt-secret-in-production
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
BASE_CURRENCY_DEFAULT=IDR

# --- Google OAuth (M1, optional) ---
# Blank = disabled (server returns 503 on /auth/google). Create a GCP OAuth
# client of type "Web application"; the server redeems the authorization code
# your mobile app produces via expo-auth-session.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Transactional email (password reset) ---
# Blank key = the mock sender: nothing is delivered, the message (reset code
# included) is logged instead. Because that logs a credential, production
# refuses to boot on a blank key unless MAIL_MOCK=true says you meant it.
# MAIL_FROM needs a domain verified in Resend; the default sandbox sender only
# delivers to your own account address.
RESEND_API_KEY=
MAIL_FROM=Financi-Ally <onboarding@resend.dev>
MAIL_MOCK=false

# --- Recurring scheduler (M6) ---
# Sweeps due rules and posts their entries. Posting is idempotent per
# (rule, occurrence date), so extra sweeps or a second replica can't double-post.
# RECURRING_TZ is the calendar the scheduler resolves occurrence dates in — set
# it to your users' zone (e.g. Asia/Jakarta) so "the 1st" means their 1st.
RECURRING_ENABLED=true
RECURRING_INTERVAL=15m
RECURRING_TZ=UTC

# --- Receipt scanning (M10) ---
# A photographed receipt goes to a vision model and comes back as a draft entry
# the user confirms. Nothing here posts: the confirmed draft travels the normal
# ledger path and is validated exactly like a hand-typed entry.
#
# Blank key = the mock extractor, which returns the SAME fixed draft for every
# photo without reading it. Shipping that unnoticed would have users confirming
# a fabricated expense, so production refuses to boot on a blank key unless
# SCAN_MOCK=true says you meant it.
#
# SCAN_REAP_AFTER is how long an uploaded-but-never-confirmed image survives
# before the sweeper deletes it — a scan uploads the photo before the user
# decides, so abandoned scans need collecting. It must comfortably outlast the
# gap between scanning offline and the next successful sync, or a real receipt
# gets collected before its entry reaches the server.
ANTHROPIC_API_KEY=
SCAN_MODEL=claude-haiku-4-5
SCAN_MOCK=false
SCAN_REAP_AFTER=168h

# SCAN_DAILY_LIMIT caps scans per user per UTC day. Every scan is a paid vision
# call, so without a cap one authenticated client in a loop drains the budget
# for everyone. Set well above real use — the point is a ceiling on abuse, not a
# quota users have to ration. 0 or less disables it.
SCAN_DAILY_LIMIT=50

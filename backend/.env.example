# Copy to .env. All optional — defaults hit the local docker-compose Postgres.
SERVER_PORT=8080
ENVIRONMENT=development

# Matches docker/compose.yml (financially:financially@localhost:5433/financially).
DATABASE_URL=postgres://financially:financially@localhost:5433/financially?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE=5m
DB_CONN_MAX_LIFE=1h

{
  "name": "financially-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:local:android": "eas build --profile preview --platform android --local",
    "build:local:ios": "eas build --profile development --platform ios --local",
    "gen": "openapi-typescript ../shared-context/contracts/openapi.yaml -o src/lib/api-types.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && tsc -p tsconfig.check.json && TZ=Europe/London node .check/lib/checks.js && node scripts/check-tokens.mjs && eslint . && node --test scripts/eslint-rules.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@nozbe/watermelondb": "^0.28.0",
    "@tanstack/react-query": "^5.101.3",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.8",
    "expo-auth-session": "~57.0.4",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "^57.0.9",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.1",
    "lucide-react-native": "^1.25.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^10.8.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  }
}

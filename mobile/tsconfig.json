{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "types": [
      "nativewind/types"
    ],
    "paths": {
      "react-native/types/*": [
        "./node_modules/react-native/types/*"
      ],
      "@financially/domain/*": [
        "../shared-context/domain/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
